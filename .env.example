BLADE_S3_BUCKET=wind-turbine-dataset-2026
AWS_DEFAULT_REGION=ap-southeast-2
BLADE_PORT=8765
# 宿主机数据根（挂进容器 /data）
BLADE_HOST_DATA=/data
# 展示 JPEG（算法仍全分辨率；0=不缩）
BLADE_VIEW_MAX_SIDE=960
BLADE_VIEW_JPEG_QUALITY=80

# 公网评审：两者都设才启用 HTTP Basic Auth
BLADE_BASIC_USER=review
BLADE_BASIC_PASS=choose-a-long-secret
